DATABASE_URL="postgresql://user:password@host:5432/dbname"
PORT=3001

# Origine autorisée pour le CORS (front Next.js en local)
CORS_ORIGIN="http://localhost:3000"

# Envoi d'e-mail — laisser vide en dev, à fournir plus tard (ex. Resend).
EMAIL_PROVIDER_API_KEY=""

# Gate temporaire de l'interface formateur (module d'évaluation).
# À remplacer par un vrai compte formateur quand le système de comptes existera.
TRAINER_ACCESS_CODE="change-me"

# Identifiants de test pour les Comptes Apprenant / Formateur (démo design,
# pas un vrai système de comptes). À remplacer quand le module RH existera.
APPRENANT_TEST_MATRICULE="change-me"
APPRENANT_TEST_PASSWORD="change-me"
FORMATEUR_TEST_MATRICULE="change-me"
FORMATEUR_TEST_PASSWORD="change-me"
ADMIN_TEST_MATRICULE="change-me"
ADMIN_TEST_PASSWORD="change-me"

# Doc Swagger (/api/docs) — laisser vide pour désactiver la doc.
SWAGGER_USER=""
SWAGGER_PASSWORD=""

# Stockage objet (Railway Bucket, S3-compatible) — fichiers audio des
# mises en situation (module d'évaluation). Voir `railway bucket credentials`.
AWS_ENDPOINT_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_DEFAULT_REGION="auto"

# Classes virtuelles (Daily.co) — laisser vide en dev, salle non créée
# (le front affiche "Bientôt disponible") tant que ce n'est pas fourni.
DAILY_API_KEY=""

# URL publique de CE backend (pas du frontend) — sert à enregistrer le
# webhook de présence Daily. Appeler une fois POST /admin/daily-webhook/setup
# (protégé FormateurGuard) une fois DAILY_API_KEY renseignée, puis copier le
# "hmac" renvoyé dans DAILY_WEBHOOK_SECRET ci-dessous (visible une seule fois).
BACKEND_PUBLIC_URL=""
DAILY_WEBHOOK_SECRET=""

# URL publique du frontend, utilisée dans les liens des emails de rappel.
FRONTEND_URL="http://localhost:3000"
