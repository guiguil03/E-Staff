// e-Staf — schéma de données du backend NestJS.
//
// Provider PostgreSQL (Railway) — DATABASE_URL fourni par le service
// Postgres Railway en production, ou par le tunnel/URL publique Railway en
// dev local. Les statuts restent des String plutôt que des enums Prisma
// (choix fait à l'époque du SQLite local, qui ne supportait pas les enums) ;
// peuvent être convertis en vrais enums Prisma dans une migration séparée.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Bouton 1 — "Proposer un projet d'externalisation"
// ---------------------------------------------------------------------------

model EntrepriseProjet {
  id String @id @default(cuid())

  // 1. Informations sur l'entreprise
  companyName String
  taxId       String // SIRET / NIF / STAT
  sector      String
  address     String
  country     String

  // 2. Contact & décisionnaire
  contactName String
  contactRole String
  email       String
  phone       String

  // 3. Cahier des charges & attentes
  serviceType  String // Squad commerciale, Support client, Collecte de dons, Saisie/Back-office, Voix off, Montage, Copywriting
  teamSize     String
  startDate    String
  needsDetails String

  // 4. Consentement RGPD (obligatoire)
  consentAt DateTime

  // "nouveau" | "contacte" | "qualifie" | "converti"
  status    String   @default("nouveau")
  createdAt DateTime @default(now())

  contratsB2B ContratB2B[]
}

// ---------------------------------------------------------------------------
// Page "Former son équipe" — prise de rendez-vous par secteur
// ---------------------------------------------------------------------------

model EntrepriseFormation {
  id String @id @default(cuid())

  companyName String
  contactName String
  email       String
  phone       String

  // "francais-admin-b2b" | "tourisme-hotellerie" | "centres-appels" | "bootcamp" | "vivier" | ""
  secteur  String
  effectif String
  // "rendez-vous" | "audit" | "devis" — quel CTA a déclenché la demande
  motif    String
  message  String?

  consentAt DateTime
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Formulaires d'inscription (examens DELF/DALF/TEF/DFP, FOL, métiers Studio
// Métier) — voir components/RegistrationForm.tsx.
// ---------------------------------------------------------------------------

model Registration {
  id String @id @default(cuid())

  // "delf-dalf" | "tef-canada" | "dfp" | "fol" | slug d'un métier Studio
  // Métier — voir components/RegistrationForm.tsx pour les segments réels.
  segment String

  firstName String
  email     String
  phone     String

  // Libellé lisible du programme choisi dans le menu déroulant "Type de
  // formation" (ex. "DFP Santé") — uniquement rempli par le funnel Examens
  // (obligatoire côté UI là-bas, voir DiplomaCard.tsx) ; les autres funnels
  // (FOL, entreprises, Studio Métier) ne l'envoient pas, d'où le champ
  // optionnel ici plutôt qu'imposé à tout le monde.
  typeFormation String?

  // CV facultatif, déposé au même moment que l'inscription — même stockage
  // S3 et même principe de clé stable que Candidat.cvKey (voir
  // EvaluationService.uploadCv).
  cvKey        String?
  cvUploadedAt DateTime?

  // "nouveau" | "contacte" | "contrat_envoye" | "en_attente_paiement" | "converti"
  status    String   @default("nouveau")
  createdAt DateTime @default(now())

  // ---------------------------------------------------------------------
  // Contrat & paiement — même principe que EvaluationAttempt (PDF généré à
  // l'envoi, e-mail réel avec lien vers une page publique où l'inscrit
  // consulte son contrat). Flux déclaratif (2026-09-09) : les coordonnées
  // de paiement (Mobile Money, RIB) sont affichées sur la page, l'inscrit
  // transmet lui-même sa référence + accepte les CGU, l'admin confirme
  // après vérification manuelle sur son compte — voir RegistrationsService.
  // ---------------------------------------------------------------------
  contractDuree      String?
  contractFrais      String?
  contractConditions String?
  contractPdfKey     String?
  contractSentAt     DateTime?

  // Champs pour un paiement en ligne automatisé (Papi) — code backend
  // conservé mais inutilisé côté produit depuis le retour au flux
  // déclaratif ci-dessus (2026-09-09) ; réactivable plus tard sans
  // migration si un vrai compte marchand est ouvert.
  paymentAmount         Int?
  papiReference         String?
  papiNotificationToken String?

  // "papi" | "manuel" — renseigné à la confirmation, pour distinguer un
  // paiement auto-confirmé par webhook Papi d'une confirmation manuelle
  // après virement.
  paymentMethod String?

  paymentReference   String?
  // Reçu/capture d'écran de la transaction, optionnel — accélère la
  // vérification manuelle par l'admin (voir InscriptionsPanel).
  paymentReceiptKey  String?
  paymentConfirmedAt DateTime?

  // Preuve d'acceptation des CGU (article "0% remboursement", assiduité...)
  // au moment de la soumission de la référence de paiement — voir
  // /conditions-generales et submitPaymentReferencePublic.
  cguAcceptedAt DateTime?
}

// ---------------------------------------------------------------------------
// Demandes de compte (page /creer-un-compte) — voir
// components/comptes/AccountCreationForm.tsx et roles.ts pour les 8 rôles.
// Une demande n'active jamais un compte automatiquement : la RH attribue le
// matricule séparément une fois une des conditions (test, convention,
// entretien) remplie.
// ---------------------------------------------------------------------------

model AccountRequest {
  id String @id @default(cuid())

  role String // un des ids de components/comptes/roles.ts

  firstName String
  email     String
  phone     String

  // "nouveau" | "contacte" | "traite"
  status    String   @default("nouveau")
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Bouton 2 — "Devenir Connecteur e-Staf"
// ---------------------------------------------------------------------------

model Connecteur {
  id String @id @default(cuid())

  // Étape 1 — coordonnées
  firstName String
  lastName  String
  email     String
  phone     String

  // Étape 3 — questionnaire de pré-qualification
  activityType      String // Cabinet recrutement / Consultant RH-BizDev / Agence / Autre réseau B2B
  clientCount       String // 1-5 / 5-15 / +15
  soughtRoles       String // JSON-encoded array of checked roles
  cvVolume          String // <50 / 50-200 / >200
  budgetPerAgent    String // <500€ / 500-1000€ / >1000€
  presentationMode  String // Recommandation directe / RDV à trois / Marque blanche
  paymentChannel    String // Virement / Mobile Money / Stripe-PayPal-Wise
  opportunityTiming String // Oui immédiat / Oui 1-3 mois / Non

  // "nouveau" | "contacte" | "actif"
  status    String   @default("nouveau")
  createdAt DateTime @default(now())

  apprenantsApportes   Apprenant[]
  contratsApportes     ContratB2B[]
  commissionsDemarrage CommissionDemarrageApporteur[]
}

// ---------------------------------------------------------------------------
// Module d'évaluation des candidats
// ---------------------------------------------------------------------------

model Candidat {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String
  createdAt DateTime @default(now())

  // CV déposé à l'étape "Coordonnées" du test (optionnel, PDF) — même
  // stockage S3/Railway que l'audio/vidéo du test. Clé S3, pas le fichier.
  cvKey        String?
  cvUploadedAt DateTime?

  // Agent d'acquisition indiqué par le candidat lui-même à l'étape
  // "Coordonnées" du test (liste déroulante, voir EvaluationService.
  // listAgentsAcquisition) — distinct du Connecteur/apporteur B2B, voir
  // AgentAcquisition. Recopié sur l'Apprenant à la confirmation de paiement
  // (EvaluationService.confirmPayment) pour que le suivi RH n'ait pas besoin
  // de remonter jusqu'au Candidat à chaque calcul.
  agentAcquisitionId String?
  agentAcquisition   AgentAcquisition? @relation(fields: [agentAcquisitionId], references: [id])

  attempts EvaluationAttempt[]

  @@index([agentAcquisitionId])
}

// ---------------------------------------------------------------------------
// Suivi des Agents d'Acquisition (commissions RH) — distinct du Connecteur
// (apporteur B2B, onboarding + commission récurrente 5%) : un agent
// d'acquisition est indiqué directement par le candidat au moment du test
// (liste déroulante, pas de texte libre — évite qu'une faute de frappe
// éclate les statistiques d'un même agent), avec une commission fixe de 5€
// par conversion et 5€ par réinscription (voir RhService.
// getSuiviAgentsAcquisition, Reinscription).
// ---------------------------------------------------------------------------
model AgentAcquisition {
  id        String   @id @default(cuid())
  nom       String
  createdAt DateTime @default(now())

  candidats  Candidat[]
  apprenants Apprenant[]
}

model EvaluationAttempt {
  id         String   @id @default(cuid())
  candidatId String
  candidat   Candidat @relation(fields: [candidatId], references: [id])

  // "en_cours" | "soumis" | "en_correction" | "corrige" | "rejete"
  // | "valide_pret_envoi" | "contrat_envoye" | "en_attente_paiement" | "active"
  status String @default("en_cours")

  // Réponses brutes (auto-corrigées) — JSON { questionId: réponse }
  lexiqueAnswers String?
  oralAnswers    String?

  // Scores /20 par épreuve. Le Bloc 1 (lexiqueScore) est désormais composite
  // (2026-08-25) : Partie 1 = QCM (lexiqueQcmScore, /10, calculé
  // automatiquement à la soumission des réponses) + Partie 2 = questions
  // ouvertes/rédaction (voir EcritOuvertResponse, /10, notée par le
  // formateur) — lexiqueScore = lexiqueQcmScore + EcritOuvertResponse.score,
  // rempli seulement une fois la Partie 2 corrigée (même logique que
  // situationsScore/videoScore/essayScore, alimentés au fur et à mesure de
  // la correction). oralScore reste calculé automatiquement à la soumission
  // (Bloc 4 encore un QCM pur).
  lexiqueQcmScore Float?
  lexiqueScore    Float?
  oralScore       Float?
  situationsScore Float?
  videoScore      Float?
  essayScore      Float?

  // Score global /100 et palier — calculés une fois toutes les épreuves
  // notées (voir src/evaluation/scoring.ts). Les 5 blocs du cahier des
  // charges sont désormais tous implémentés (Bloc 2 "Commentaire
  // Argumentatif" ajouté le 2026-08-25) ; computeTotalScore reste au
  // prorata des scores définis par sécurité, mais couvre maintenant les 5.
  totalScore Float?
  // "refuse" | "formation_b1" | "niveau_b2" | "niveau_c1" | "placement_direct"
  tier       String?

  submittedAt       DateTime?
  gradedAt          DateTime?
  resultEmailSentAt DateTime?

  // Notification interne au formateur -> RH ("Envoyer les résultats vers
  // RH", écran de correction) — distincte de l'envoi des résultats au
  // candidat ci-dessous.
  rhNotifiedAt DateTime?

  // Envoi des résultats au candidat depuis la fiche RH (Cycle complet),
  // avec choix du modèle de message et du canal — indépendant de l'envoi du
  // contrat (contractSentAt) : peut se faire avant que le contrat soit prêt.
  // resultatsCanal: "mail" | "whatsapp" — resultatsModele: "delf_dalf" |
  // "tef" | "dfp" | "postulant_prod"
  resultatsEnvoyesLe DateTime?
  resultatsCanal     String?
  resultatsModele    String?

  // ---------------------------------------------------------------------
  // Pipeline post-test — validation RH -> contrat -> paiement -> matricule
  // ---------------------------------------------------------------------

  // Termes saisis par l'admin RH à la validation (pas de modèle figé, voir
  // etaff-*-brainstorm : variable selon le candidat/niveau obtenu).
  contractDuree      String?
  contractFrais      String?
  contractConditions String?
  // Clé S3 du PDF généré à la validation (StorageService), envoyé par le
  // cron de 20h — généré une seule fois, pas régénéré à chaque tentative
  // d'envoi.
  contractPdfKey     String?
  contractSentAt     DateTime?

  // Référence transmise par le candidat après paiement Mobile Money /
  // virement (pas de webhook — confirmation manuelle par un admin qui
  // vérifie sur son compte, voir paymentConfirmedAt).
  paymentReference   String?
  paymentConfirmedAt DateTime?

  // Rempli au moment de la confirmation de paiement : génère un vrai
  // Apprenant (matricule + groupe choisi par l'admin) et le lie ici.
  apprenantId String?    @unique
  apprenant   Apprenant? @relation(fields: [apprenantId], references: [id])

  createdAt DateTime @default(now())

  situationResponses  SituationResponse[]
  videoResponses      VideoResponse[]
  essayResponse       EssayResponse?
  ecritOuvertResponse EcritOuvertResponse?

  @@index([candidatId])
}

// Une réponse audio à une des 10 situations professionnelles (le candidat
// en choisit 5). Notée sur 4 points par le formateur via une grille de
// critères à cocher.
model SituationResponse {
  id        String            @id @default(cuid())
  attemptId String
  attempt   EvaluationAttempt @relation(fields: [attemptId], references: [id])

  situationIndex Int // 1 à 10, voir src/evaluation/situations.ts
  audioUrl       String

  score          Float? // 0 à 4
  gradedCriteria String? // JSON des critères cochés par le formateur
  gradedAt       DateTime?

  createdAt DateTime @default(now())

  @@unique([attemptId, situationIndex])
}

// Une réponse vidéo à une des 2 tâches du Bloc 5 (Débat Plateau Télé / Pitch
// de Synthèse, toutes deux obligatoires — voir src/evaluation/video-tasks.ts).
// Notée sur 10 points par le formateur via une grille de critères.
model VideoResponse {
  id        String            @id @default(cuid())
  attemptId String
  attempt   EvaluationAttempt @relation(fields: [attemptId], references: [id])

  taskIndex Int // 1 ou 2, voir src/evaluation/video-tasks.ts
  videoUrl  String

  // Sujet puis rôle choisis par le candidat quand la tâche propose plusieurs
  // sujets/options (ex. tâche 1 "Débat Plateau Télé" : sujet "influenceurs"
  // ou "inégalités salariales", chacun avec Option A/B — voir
  // VideoTask.subjects dans video-tasks.ts) — le formateur en a besoin pour
  // juger "l'adéquation à la consigne" en sachant quel guide le candidat
  // suivait. Null pour les tâches sans choix (ex. "Pitch de Synthèse") ou
  // les réponses déposées avant ces champs.
  subjectKey String?
  optionKey  String?

  score          Float? // 0 à 10
  gradedCriteria String? // JSON des critères cochés par le formateur
  gradedAt       DateTime?

  createdAt DateTime @default(now())

  @@unique([attemptId, taskIndex])
}

// Le Bloc 2 (Commentaire Argumentatif, contenu client fourni le 2026-08-25) :
// le candidat choisit UN sujet parmi 3 et rédige un essai argumenté (400-500
// mots) directement en texte — pas de fichier, contrairement aux Blocs 3/5.
// Une seule ligne par tentative (contrairement à SituationResponse/
// VideoResponse qui en admettent plusieurs), d'où le champ unique sur
// attemptId plutôt que sur (attemptId, subjectKey).
model EssayResponse {
  id        String            @id @default(cuid())
  attemptId String            @unique
  attempt   EvaluationAttempt @relation(fields: [attemptId], references: [id])

  subjectKey String // voir src/evaluation/commentaire-argumentatif.ts
  text       String
  wordCount  Int

  score          Float? // 0 à 20
  gradedCriteria String? // JSON des critères cochés par le formateur
  gradedAt       DateTime?

  createdAt DateTime @default(now())
}

// Bloc 1 — "Partie 2" (questions ouvertes + rédaction, 10 pts sur les 20 du
// bloc — voir LEXIQUE_QUESTIONS/scoreQcm pour la "Partie 1", QCM auto-
// corrigé, 10 pts). Une seule ligne par tentative comme EssayResponse : le
// candidat répond en une fois à tous les exercices (reformulation, 3
// pluriels, figure de style, synonyme, rédaction 150-200 mots), notés
// globalement par le formateur — voir src/evaluation/partie-ouverte.ts.
model EcritOuvertResponse {
  id        String            @id @default(cuid())
  attemptId String            @unique
  attempt   EvaluationAttempt @relation(fields: [attemptId], references: [id])

  reformulationText  String
  plurielTexts       String // JSON string[3]
  styleText          String
  synonymeText       String
  redactionText      String
  redactionWordCount Int

  score          Float? // 0 à 10
  gradedCriteria String? // JSON des critères notés par le formateur
  gradedAt       DateTime?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Cockpit Formateur / Compte Apprenant — planification & classes virtuelles
// ---------------------------------------------------------------------------
// Premières tables réelles pour ce module (le reste du Cockpit Formateur —
// grilles de notation, radar de compétences — tourne encore sur de la
// donnée de démo en dur côté front, voir components/compte-formateur/
// exampleData.ts). Seedées avec les mêmes 6 groupes / 30 apprenants que
// exampleData.ts (voir prisma/seed.ts) pour que la démo reste cohérente.

model Groupe {
  id    String @id @default(cuid())
  cle   String @unique // "A".."F"
  label String // "Groupe A"

  // Formateur en charge de ce groupe — nullable, un groupe peut ne pas
  // (encore) avoir de formateur assigné (voir RhService.assignFormateur).
  formateurId String?
  formateur   Formateur? @relation(fields: [formateurId], references: [id])

  // Offre/programme suivi par ce groupe (ex. "DELF/DALF", "TEF Canada",
  // "DFP Affaires", "FOL", "Studio Métier — Closer"...) — texte libre,
  // pas d'enum fermé tant que le catalogue réel des offres n'est pas
  // stabilisé côté produit. Nullable : les 6 groupes A-F existants n'ont pas
  // ce type renseigné (seedés avant ce champ).
  typeCours String?

  // Dates de la vague — saisies manuellement par la RH (pas de règle
  // automatique de calcul, une vague peut être décalée). dateFin sert aussi
  // à distinguer une vague active d'une vague clôturée (voir
  // RhService.getVagues) une fois cette notion introduite côté UI.
  dateDebut DateTime?
  dateFin   DateTime?

  apprenants Apprenant[]
  seances    Seance[]
  diffusions Diffusion[]

  @@index([formateurId])
}

// Annonce diffusée par un formateur — jusqu'ici BroadcastCard (Cockpit
// Formateur) ne faisait qu'un setState local, rien n'était sauvegardé ni
// transmis. groupeId nul = tous les groupes de ce formateur (borné par la
// règle d'exclusivité formateur/type de cours, voir
// RhService.assertFormateurTypeCoursCompatible) plutôt qu'une vraie
// diffusion académie entière.
model Diffusion {
  id          String    @id @default(cuid())
  formateurId String
  formateur   Formateur @relation(fields: [formateurId], references: [id])
  groupeId    String?
  groupe      Groupe?   @relation(fields: [groupeId], references: [id])
  message     String
  createdAt   DateTime  @default(now())

  @@index([formateurId])
  @@index([groupeId])
}

model Formateur {
  id        String @id @default(cuid())
  matricule String @unique
  prenom    String
  nom       String
  email     String

  // Compte individuel (2026-09-16) — même principe que Apprenant.password :
  // hash bcrypt, généré par la RH à la création (RhService.createFormateur)
  // ou à la régénération (RhService.regenerateFormateurCredentials) et
  // envoyé une seule fois en clair par e-mail. Nullable pour les formateurs
  // déjà en base avant cette migration (ne peuvent pas encore se connecter
  // individuellement tant que la RH n'a pas régénéré leurs identifiants).
  password            String?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  // Fixe mensuel négocié — base du Net à Payer (voir PaiementFormateur),
  // même principe que Superviseur.tarifFixe côté Production. Nullable tant
  // que la RH ne l'a pas renseigné.
  tarifFixe Float?

  groupes    Groupe[]
  paiements  PaiementFormateur[]
  documents  FormateurDocument[]
  bilans     BilanFormateur[]
  diffusions Diffusion[]
}

// Bilan hebdomadaire validé par le formateur (voir CockpitService.submitBilanHebdo)
// — jusqu'ici WeeklyReportPanel ne faisait qu'un setState local, rien n'était
// sauvegardé ni transmis. statsSnapshot fige les chiffres du rapport hebdo
// au moment de la validation (voir CockpitService.getRapportHebdo) pour que
// l'historique reste lisible même si les chiffres bougent ensuite.
model BilanFormateur {
  id          String    @id @default(cuid())
  formateurId String
  formateur   Formateur @relation(fields: [formateurId], references: [id])

  constat String
  analyse String
  axes    String

  statsSnapshot Json

  createdAt DateTime @default(now())

  @@index([formateurId])
}

// Documents rattachés à un formateur — fiches de préparation (déposées
// librement par le formateur lui-même) et contrat (déposé par la RH). Un
// seul modèle pour les deux plutôt que deux tables quasi identiques ;
// `type` distingue l'usage, `uploadedBy` qui l'a déposé. Fichier réel dans
// le bucket S3-compatible (voir StorageService), storageKey seule en base.
model FormateurDocument {
  id          String    @id @default(cuid())
  formateurId String
  formateur   Formateur @relation(fields: [formateurId], references: [id])

  type       String // "fiche_preparation" | "contrat"
  filename   String
  storageKey String
  uploadedBy String // "formateur" | "rh"

  createdAt DateTime @default(now())

  @@index([formateurId])
}

// Paie individuelle d'un formateur pour une période — miroir de PaiementAgent
// côté Production, mais rattachée directement au Formateur (pas à une
// Mission) puisqu'un formateur encadre des groupes, pas des contrats
// clients. Regroupée côté service par "type de cours" (TEF Canada, DELF
// DALF, DFP, FOL, Formation externe — voir bucketTypeCoursPaie dans
// RhService) pour le tableau de la page Paie & Commissions. Contrairement à
// PaiementAgent, retenue/prime restent des montants saisis/corrigés par la
// RH plutôt que calculés automatiquement : il n'existe pas de pointage réel
// (absence/retard) par formateur en base, seules les heures effectuées
// (dérivées des Seance réellement programmées sur ses groupes) sont réelles.
model PaiementFormateur {
  id String @id @default(cuid())

  formateurId String
  formateur   Formateur @relation(fields: [formateurId], references: [id])

  periode String // "AAAA-MM"

  montantBase  Float @default(0)
  montantPrime Float @default(0)
  retenue      Float @default(0)

  moyenPaiement String? // "Mobile Money", "Virement bancaire", "Espèces", etc.

  statut       String    @default("en_attente")
  datePaiement DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formateurId, periode])
}

model Apprenant {
  id        String   @id @default(cuid())
  matricule String   @unique
  prenom    String
  nom       String
  email     String
  // Date d'inscription réelle — sert au "Mon Casier" du Compte Apprenant
  // (date d'inscription affichée). Absent avant cette migration : les
  // apprenants déjà en base récupèrent la date de la migration elle-même
  // (DEFAULT CURRENT_TIMESTAMP), pas une vraie date d'inscription rétroactive.
  createdAt DateTime @default(now())

  // Hash bcrypt — jamais le mot de passe en clair. Généré automatiquement à
  // la confirmation de paiement (voir EvaluationService.confirmPayment) et
  // envoyé une seule fois, en clair, dans l'e-mail de bienvenue. Nullable
  // pour ne pas casser les apprenants déjà seedés avant ce champ — un
  // compte sans mot de passe ne peut simplement pas encore se connecter.
  password String?

  // Mot de passe oublié : jeton à usage unique, expire 1h après génération.
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  // Échéance de l'abonnement en cours (renouvellement à date fixe, décision
  // produit du 2026-08-24) — saisie/mise à jour manuellement par le
  // formateur (pas de facturation automatique). Null tant qu'aucune date
  // n'a été fixée (apprenants seedés/créés avant ce champ) : le Cockpit les
  // affiche à part, ni "à jour" ni "en retard", plutôt que de leur prêter un
  // statut inventé.
  abonnementExpireAt DateTime?

  groupeId String
  groupe   Groupe @relation(fields: [groupeId], references: [id])

  // ---- Traçabilité recrutement & apporteurs (synchro ATS, 2026-08-28) ------

  // Apporteur d'affaires à qui ce candidat est rattaché, s'il vient d'un
  // apport plutôt que d'une candidature directe — sert de base au calcul de
  // la commission récurrente de 5% (voir ProductionService.
  // getCommissionsApporteurs).
  connecteurId String?
  connecteur   Connecteur? @relation(fields: [connecteurId], references: [id])

  // Libre : "Candidature spontanée", "Réseau", nom de l'apporteur, etc. —
  // distinct de connecteurId, qui est le seul champ structurellement fiable
  // pour le calcul de commission.
  sourceRecrutement String?

  // "formation" | "essai" | "actif" | "inactif" — statut RH explicite de
  // l'agent, distinct du statut de production calculé (Mission.dateFin) : un
  // agent entre missions n'est pas forcément "inactif" au sens RH/commission.
  // Contrôle si la commission récurrente de l'apporteur court toujours.
  statutAgent String @default("formation")

  // ---- Coffre-fort coordonnées de paiement (onboarding RH) -----------------

  // Numéro RIB ou Mobile Money, selon moyenPaiementType — saisi/vérifié une
  // fois par la RH, réutilisé automatiquement sur chaque paiement (voir
  // PaiementAgent) plutôt que ressaisi à chaque fois.
  ribOuMobileMoney       String?
  moyenPaiementType      String? // "RIB" | "MVola" | "Orange Money" | "Airtel Money"
  coordonneesVerifieesLe DateTime?

  presences         Presence[]
  notations         Notation[]
  // Tentative d'évaluation à l'origine de la création de ce compte, quand
  // applicable (pipeline post-test) — absent pour les apprenants seedés/
  // créés manuellement.
  evaluationAttempt EvaluationAttempt?

  // Versements réels reçus pour la formation (voir EncaissementFormation) —
  // un apprenant peut payer en plusieurs fois (mensualités), d'où une
  // relation 1-N plutôt qu'un montant unique sur l'Apprenant.
  encaissements EncaissementFormation[]

  // Missions de production (voir Mission) — un apprenant diplômé peut
  // enchaîner plusieurs missions dans le temps (dateFin renseignée = mission
  // terminée) ; la mission avec dateFin=null (s'il y en a une) est la
  // mission active actuelle.
  missions Mission[]

  // Recopié depuis Candidat.agentAcquisitionId à la confirmation de paiement
  // (voir EvaluationService.confirmPayment) — null pour un compte créé
  // directement par la RH (RhService.createApprenantAccount), sans agent.
  agentAcquisitionId String?
  agentAcquisition   AgentAcquisition? @relation(fields: [agentAcquisitionId], references: [id])

  // Renouvellements d'abonnement FOL comptant comme "réinscription" pour la
  // commission de l'agent d'acquisition (voir RhService.renouvelerAbonnement).
  reinscriptions Reinscription[]

  @@index([groupeId])
  @@index([connecteurId])
  @@index([agentAcquisitionId])
}

// Un renouvellement d'abonnement FOL déclenché par la RH — évènement tracé
// (pas juste un écrasement de abonnementExpireAt) pour pouvoir compter le
// nombre de réinscriptions dans le suivi des Agents d'Acquisition.
model Reinscription {
  id          String    @id @default(cuid())
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id])

  renouveleLe      DateTime @default(now())
  nouvelleEcheance DateTime

  @@index([apprenantId])
}

// Horaire réel d'une des 12 séances d'un groupe. startAt reste nullable :
// une séance existe dans le planning (numéro 1-12) avant même d'être
// programmée par le formateur.
model Seance {
  id       String @id @default(cuid())
  groupeId String
  groupe   Groupe @relation(fields: [groupeId], references: [id])
  numero   Int // 1 à 12

  startAt      DateTime?
  dureeMinutes Int       @default(90)
  objectifs    String?

  // Salle Daily.co créée automatiquement dès que startAt est renseigné pour
  // la première fois (voir ClasseVirtuelleService) — null tant que
  // DAILY_API_KEY n'est pas configurée ou que startAt n'est pas défini.
  dailyRoomName String?
  dailyRoomUrl  String?

  // Anti-doublon pour le cron de rappels (ClasseVirtuelleReminderService).
  rappelJ1EnvoyeAt    DateTime?
  rappel15minEnvoyeAt DateTime?

  presences Presence[]
  notations Notation[]

  @@unique([groupeId, numero])
}

// Notation d'une compétence pour un apprenant sur une séance — remplace le
// state frontend local (planningGradesStore) pour que le formateur ET
// l'apprenant lisent la même donnée depuis leurs comptes respectifs
// (décision produit 2026-08-07). Sert aussi de file "Évaluer & Corriger" :
// une ligne avec fileKey renseigné et gradedAt nul est un devoir en attente.
model Notation {
  id String @id @default(cuid())

  seanceId String
  seance   Seance @relation(fields: [seanceId], references: [id])

  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id])

  competence String // CompetencyKey (voir gradingGrids.ts côté front)

  // Dépôt de l'apprenant — uniquement pour les compétences à grille
  // (expression_orale/ecrite, posture_eloquence) ; comprehension_orale/ecrite
  // n'ont pas de dépôt, juste une note directe du formateur.
  fileKey  String?
  fileName String?
  soumisAt DateTime?

  // Notation du formateur — gridData est le JSON { selections, anomaly?,
  // adjustments? } tel que produit par DelfGrid/PostureGrid côté front ;
  // note sert aux compétences upload-only (comprehension_orale/ecrite).
  gridData     String?
  note         Float?
  commentaires String?
  scoreOn20    Float?
  gradedAt     DateTime?

  @@unique([seanceId, apprenantId, competence])
  @@index([apprenantId])
}

// Présence en classe virtuelle — alimentée par les webhooks Daily
// (participant.joined/participant.left, voir daily-webhook.controller.ts).
// apprenantId est nullable : un webhook peut arriver pour un participant
// qu'on n'arrive pas à rattacher (ex. le formateur, ou un identifiant de
// token corrompu) — on garde quand même la ligne plutôt que de la perdre.
model Presence {
  id       String @id @default(cuid())
  seanceId String
  seance   Seance @relation(fields: [seanceId], references: [id])

  apprenantId String?
  apprenant   Apprenant? @relation(fields: [apprenantId], references: [id])
  role        String // "apprenant" | "formateur" | "inconnu"

  dailyParticipantId String  @unique
  displayName        String?

  joinedAt      DateTime
  leftAt        DateTime?
  dureeSecondes Int?

  @@index([seanceId])
  @@index([apprenantId])
}

// ---------------------------------------------------------------------------
// Forum — "Le Live du mois"
// ---------------------------------------------------------------------------
// Distinct de Seance : public (pas rattaché à un Groupe/Apprenant), diffusion
// 1 hôte (l'invité, via le compte Admin) → plusieurs spectateurs, pas un
// appel multi-parties. Planifié par le rôle Admin (voir AdminGuard),
// affiché sur la page /forum publique.
model ForumLive {
  id String @id @default(cuid())

  titre       String
  invite      String // nom de l'invité du mois
  description String?

  startAt      DateTime?
  dureeMinutes Int       @default(60)

  // Salle Daily.co en mode owner_only_broadcast (voir daily.service.ts) —
  // seul l'hôte (Admin) a caméra/micro, les spectateurs sont en lecture seule.
  dailyRoomName String?
  dailyRoomUrl  String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Portail RH — réunions convoquées par la RH (équipe interne, partenaires,
// ou les deux) — voir rh.module.ts. Distinct de ForumLive (diffusion publique
// grand public) et de Seance (cours pédagogique programmé) : une réunion RH
// est un rendez-vous interne/partenaires, pas de salle vidéo intégrée pour
// l'instant (juste planification + suivi), le lien de visio se met dans
// `lieu` si besoin (Meet/Zoom externe).
// ---------------------------------------------------------------------------

model Reunion {
  id String @id @default(cuid())

  titre       String
  description String?

  // "equipe" | "partenaires" | "tous" — qui est convoqué.
  audience String

  // Liste libre de noms/e-mails invités, JSON-encodée (String[]) — pas de
  // répertoire Partenaire/Équipe structuré à ce stade, la RH saisit les
  // participants à la main.
  participants String @default("[]")

  startAt      DateTime
  dureeMinutes Int      @default(60)
  lieu         String? // présentiel ou lien de visio externe

  // "planifiee" | "annulee"
  statut String @default("planifiee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Production — staffing des agents diplômés chez les clients B2B (Portail
// RH, phase 4, 2026-08-26). Distinct de la Formation (Groupe/Seance/
// Notation) : une Mission ne démarre qu'une fois l'apprenant sorti du cursus
// académique, sur un ContratB2B réel, sous la supervision d'un Superviseur.
// ---------------------------------------------------------------------------

model Superviseur {
  id        String @id @default(cuid())
  matricule String @unique
  prenom    String
  nom       String
  email     String

  // Fixe mensuel négocié — base du Net à Payer (voir PaiementSuperviseur),
  // sur le même principe que Mission.tarifNegocie côté agents.
  tarifFixe Float?

  ribOuMobileMoney       String?
  moyenPaiementType      String? // "RIB" | "MVola" | "Orange Money" | "Airtel Money"
  coordonneesVerifieesLe DateTime?

  missions              Mission[]
  rapportsHebdo         RapportHebdoSuperviseur[]
  paiements             PaiementSuperviseur[]
  performancesParClient PerformanceSuperviseurClient[]
}

// Paie d'un superviseur pour une période — le Fixe + la somme des primes
// par client supervisé (voir PerformanceSuperviseurClient). Un superviseur
// peut encadrer plusieurs contrats en parallèle ("Double Équipe"), chacun
// avec sa propre performance et sa propre prime, mais un seul paiement net
// global par période (voir ProductionService.getDetailPoolSuperviseurs).
model PaiementSuperviseur {
  id String @id @default(cuid())

  superviseurId String
  superviseur   Superviseur @relation(fields: [superviseurId], references: [id])

  periode String // "AAAA-MM"

  montantFixe Float @default(0)

  // "en_attente" | "paye"
  statut       String    @default("en_attente")
  datePaiement DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([superviseurId, periode])
}

// Performance et prime d'un superviseur sur UN client/contrat donné, pour
// une période — plusieurs lignes possibles par superviseur/période s'il
// encadre plusieurs contrats (voir PaiementSuperviseur.montantFixe pour la
// part fixe, commune). Le taux de performance est saisi manuellement par la
// RH (moyenne qualityScore des agents de ce contrat proposée par défaut).
model PerformanceSuperviseurClient {
  id String @id @default(cuid())

  superviseurId String
  superviseur   Superviseur @relation(fields: [superviseurId], references: [id])

  contratId String
  contrat   ContratB2B @relation(fields: [contratId], references: [id])

  periode String // "AAAA-MM"

  tauxPerformance Float? // %
  prime           Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([superviseurId, contratId, periode])
  @@index([contratId])
}

model ContratB2B {
  id String @id @default(cuid())

  clientNom String

  // Lien optionnel vers le lead d'origine (formulaire "Proposer un projet
  // d'externalisation") — nullable, un contrat peut être créé directement
  // par la RH sans être passé par ce formulaire.
  entrepriseProjetId String?
  entrepriseProjet   EntrepriseProjet? @relation(fields: [entrepriseProjetId], references: [id])

  // Apporteur d'affaires à l'origine de ce client — déclenche la commission
  // de démarrage (10%, une fois) au profit de cet apporteur. Nullable : un
  // contrat créé directement par la RH sans apporteur.
  connecteurId String?
  connecteur   Connecteur? @relation(fields: [connecteurId], references: [id])

  description String?

  // Date de signature du contrat, distincte de dateDebut (démarrage effectif
  // des prestations sur plateau) — les deux peuvent différer de plusieurs
  // semaines. Nullable : les contrats créés avant ce champ n'ont pas cette
  // info.
  dateSignature DateTime?
  dateDebut     DateTime
  dateFin       DateTime?

  // "actif" | "termine" | "suspendu"
  statut String @default("actif")

  // Montant facturé par mois — devise non modélisée séparément (Ar par
  // défaut, comme le reste du produit), nullable tant que le tarif n'est
  // pas encore négocié/saisi.
  tarifMensuel Float?

  missions                Mission[]
  factures                Facture[]
  objectifsJournaliers    ObjectifJournalier[]
  rapportsHebdo           RapportHebdoSuperviseur[]
  commissionDemarrage     CommissionDemarrageApporteur?
  performancesSuperviseur PerformanceSuperviseurClient[]

  createdAt DateTime @default(now())

  @@index([entrepriseProjetId])
  @@index([connecteurId])
}

model Mission {
  id String @id @default(cuid())

  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id])

  contratId String
  contrat   ContratB2B @relation(fields: [contratId], references: [id])

  superviseurId String?
  superviseur   Superviseur? @relation(fields: [superviseurId], references: [id])

  role      String // poste occupé sur le contrat (ex. "Closer", "Support client")
  dateDebut DateTime
  dateFin   DateTime? // null = mission active (agent actuellement en production)

  // Qualité de Service — notée périodiquement par le superviseur, /5. Null
  // tant qu'aucune évaluation n'a encore été saisie.
  qualityScore Float?

  // Salaire négocié avec le client pour ce poste ("Tarif/Position") — sert
  // de base à la marge E-Staf garantie (20% net, voir MARGIN_PCT_ESTAF côté
  // service) et de référence pour la paie réelle de l'agent (PaiementAgent).
  // Nullable : pas toujours négocié/saisi au moment de la création.
  tarifNegocie Float?

  suivisHebdo SuiviAgentHebdo[]
  paiements   PaiementAgent[]

  createdAt DateTime @default(now())

  @@index([apprenantId])
  @@index([contratId])
  @@index([superviseurId])
}

model Facture {
  id String @id @default(cuid())

  contratId String
  contrat   ContratB2B @relation(fields: [contratId], references: [id])

  periode String // "2026-09" — mois facturé
  montant Float

  // "emise" | "payee"
  statut       String    @default("emise")
  dateEmission DateTime  @default(now())
  datePaiement DateTime?

  @@index([contratId])
}

// Objectif journalier d'un contrat B2B — saisie manuelle par le superviseur
// (aucune synchronisation téléphonie/plateau n'existe dans ce produit à ce
// jour). Sert au graphique "objectif atteint tous les jours" et, agrégé par
// semaine côté service, au comparatif hebdomadaire de l'onglet 1 de la
// carte Mission/Client.
model ObjectifJournalier {
  id String @id @default(cuid())

  contratId String
  contrat   ContratB2B @relation(fields: [contratId], references: [id])

  jour        DateTime // horodatage normalisé à minuit, un enregistrement par jour et par contrat
  tauxAtteint Float // % de l'objectif journalier atteint

  createdAt DateTime @default(now())

  @@unique([contratId, jour])
}

// Suivi hebdomadaire d'un agent en mission — alimente le tableau de
// performance des agents (onglet 2 de la carte Mission/Client). Une ligne
// par mission et par semaine ISO (ex. "2026-W35").
model SuiviAgentHebdo {
  id String @id @default(cuid())

  missionId String
  mission   Mission @relation(fields: [missionId], references: [id])

  semaine String // format ISO "AAAA-Wss"

  concretisations Int     @default(0)
  tauxAbsence     Float? // %
  nbRetards       Int     @default(0)
  remarques       String?

  // ---- Pointage (synchro RH, 2026-08-28) — saisie manuelle par le
  // superviseur, aucune pointeuse réelle connectée à ce jour. Alimente le
  // calcul du Net à Payer (retenues/heures sup) en PaiementAgent.
  heuresRetardCumulees      Float @default(0)
  heuresAbsenceNonJustifiee Float @default(0)
  heuresSupValidees         Float @default(0)

  // ---- Métriques de production / télévente (synchro téléphonie, 2026-08-28)
  // — saisie manuelle, aucun système de téléphonie réel connecté à ce jour.
  // Quand caRealise > 0, la prime de l'agent se base dessus plutôt que sur
  // qualityScore (voir ProductionService.getDetailPaieAgents).
  caRealise  Float @default(0)
  nbVentes   Int   @default(0)
  rdvValides Int   @default(0)

  createdAt DateTime @default(now())

  @@unique([missionId, semaine])
}

// Rapport hebdomadaire du superviseur sur un contrat — les 3 zones de
// texte récapitulatives de l'onglet 3 de la carte Mission/Client.
model RapportHebdoSuperviseur {
  id String @id @default(cuid())

  contratId String
  contrat   ContratB2B @relation(fields: [contratId], references: [id])

  superviseurId String?
  superviseur   Superviseur? @relation(fields: [superviseurId], references: [id])

  semaine String // format ISO "AAAA-Wss"

  constat          String?
  analyse          String?
  axesAmelioration String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contratId, semaine])
  @@index([superviseurId])
}

// Ligne du "Tableau de bord financier global" — un poste de charge (sur les
// 6 postes du CA de production alloués : salaires agents, infra, pool
// superviseurs, commissions apporteurs, primes performance, commission de
// démarrage — soit 80% du CA, les 20% restants formant la marge nette
// E-Staf garantie) pour une période donnée ("AAAA-MM"). Le montant
// théorique est calculé automatiquement depuis le CA des contrats actifs
// (tarifMensuel) ; le montant réel est saisi/ajusté manuellement par la RH
// (les primes, coûts d'infra réels, etc. ne sont pas encore synchronisés
// automatiquement — voir ProductionService.getTableauFinancierGlobal).
model DecaissementProduction {
  id String @id @default(cuid())

  // "salaires_agents" | "charges_infrastructure" | "pool_superviseurs" |
  // "commissions_apporteurs" | "primes_performance" | "commission_demarrage"
  poste   String
  periode String // "AAAA-MM"

  montantTheorique Float
  montantReel      Float

  // "en_attente" | "paye"
  statut       String    @default("en_attente")
  datePaiement DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([poste, periode])
}

// Paie individuelle d'un agent en mission, pour une période donnée — la
// vue "micro" derrière les postes globaux "Salaires Fixes Agents" et
// "Primes Performance Agents" du tableau de bord financier : quel agent, sur
// quel contrat, payé à combien, avec quelle prime et par quel moyen.
// Matérialisée (get-or-create) au premier accès comme DecaissementProduction
// — montantBase par défaut = Mission.tarifNegocie, montantPrime suggérée à
// partir du qualityScore de la mission (proxy de taux d'atteinte des
// objectifs, faute de cible chiffrée par agent) — corrigible par la RH.
model PaiementAgent {
  id String @id @default(cuid())

  missionId String
  mission   Mission @relation(fields: [missionId], references: [id])

  periode String // "AAAA-MM"

  montantBase  Float @default(0)
  montantPrime Float @default(0)

  // Libre : "Mobile Money", "Virement bancaire", "Espèces", etc.
  moyenPaiement String?

  // "en_attente" | "paye"
  statut       String    @default("en_attente")
  datePaiement DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([missionId, periode])
}

// Commission de démarrage (10% du tarif mensuel du contrat, versée une
// seule fois) due à l'apporteur d'affaires qui a amené ce client — voir
// ContratB2B.connecteurId. Un seul enregistrement par contrat (jamais
// récurrent, contrairement à la commission sur la masse salariale — voir
// ProductionService.getCommissionsDemarrage).
model CommissionDemarrageApporteur {
  id String @id @default(cuid())

  contratId String     @unique
  contrat   ContratB2B @relation(fields: [contratId], references: [id])

  connecteurId String
  connecteur   Connecteur @relation(fields: [connecteurId], references: [id])

  montant Float

  // "en_attente" | "paye"
  statut       String    @default("en_attente")
  datePaiement DateTime?

  createdAt DateTime @default(now())

  @@index([connecteurId])
}

// Ligne de charge sous le poste "Charges Fixes Infrastructure" — loyer,
// connexion internet, électricité, logistique, etc., avec pièce
// justificative (voir StorageService, même bucket S3 que les devoirs/
// enregistrements d'évaluation). Une ligne par poste et par période ;
// contrairement aux autres postes du tableau de bord (calculés
// automatiquement depuis le CA), les montants théorique/réel sont saisis
// directement par la RH — pas de formule, ce sont de vraies factures.
// Prix catalogue par type de cours (Groupe.typeCours) — saisi/mis à jour
// manuellement par la RH, comme les postes de ChargeInfrastructure (pas de
// tarification automatique). Sert de base à l'état financier global de
// l'Académie (voir RhService.getEtatFinancierFormation) : 0 par défaut tant
// que la RH n'a pas renseigné de prix, jamais un montant inventé.
model TarifFormation {
  id String @id @default(cuid())

  typeCours     String @unique
  prixFormation Float  @default(0)

  updatedAt DateTime @updatedAt
}

// Encaissement réel d'un versement de formation par un apprenant — comble le
// vide identifié dans EtatFinancierFormationPanel (jusqu'ici aucune
// facture/paiement numérique réel côté Académie, seulement un CA théorique
// basé sur TarifFormation). Saisi manuellement par la RH (pas de webhook
// Mobile Money, même principe que la confirmation de paiement du pipeline
// d'admission) — un apprenant peut régler en plusieurs fois, d'où plusieurs
// lignes possibles par apprenant plutôt qu'un solde unique. `jour` sert à la
// fois de journal (tableau "jours") et de base aux comparatifs
// hebdomadaire/mensuel (voir RhService.getTendanceHebdomadaireFormation /
// getTendanceMensuelleFormation).
model EncaissementFormation {
  id String @id @default(cuid())

  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id])

  montant Float
  jour    DateTime // date du versement (normalisée à minuit)

  moyenPaiement String? // "Mobile Money", "Virement bancaire", "Espèces", etc.

  createdAt DateTime @default(now())

  @@index([apprenantId])
}

model ChargeInfrastructure {
  id String @id @default(cuid())

  poste       String // "Loyer", "Connexion Internet", "Électricité", "Logistique & Matériel", etc.
  motif       String?
  prestataire String?

  periode String // "AAAA-MM"

  montantTheorique Float
  montantReel      Float @default(0)

  // Clé S3 du fichier déposé (voir StorageService.uploadBuffer) + nom
  // d'origine pour l'affichage — null tant qu'aucune pièce n'est déposée.
  pieceJustificativeKey String?
  pieceJustificativeNom String?

  modePaiement String? // "Virement" | "MVola" | "Orange Money" | "Airtel Money" | "Espèces"

  // "en_attente" | "paye"
  statut       String    @default("en_attente")
  datePaiement DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
